    "next": "16.2.6",
    "pg": "8.16.3",
    "pg-mem": "3.0.14",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
