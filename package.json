{
  "name": "relay-webex-telegram-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Headless Telegram bridge for Webex Contact Center Custom Messaging",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
