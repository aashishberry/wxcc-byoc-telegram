# Local/test database. Render injects DATABASE_URL from its PostgreSQL service.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_SIZE=5
ALLOW_IN_MEMORY_DB=false

# Used only to produce irreversible, stable log references. Use at least 32
# random characters and keep it different from every API/webhook secret.
LOG_HASH_SECRET=
# Produces an opaque, stable Webex origin.id instead of sharing Telegram IDs.
EXTERNAL_ID_SECRET=

# Telegram Bot API configuration.
TELEGRAM_BOT_TOKEN=
# 1-256 characters from A-Z, a-z, 0-9, underscore and hyphen.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://your-host.example/api/webhooks/telegram
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_ALLOW_GROUPS=false
TELEGRAM_WELCOME_MESSAGE=Hello! Send a message and we will connect you with support.
TELEGRAM_UNSUPPORTED_MESSAGE=This message type or attachment size is not supported.
TELEGRAM_OUTBOUND_ATTACHMENT_MESSAGE=Support sent an attachment that could not be delivered through this channel.
# Plain, non-encrypted Webex outbound attachments are enabled by default.
TELEGRAM_OUTBOUND_ATTACHMENTS_ENABLED=true
# Telegram Bot API hard limit is currently 50 MB for general bot uploads.
# Keep this conservative on a 512 MB free instance; the hard Telegram upload
# ceiling remains 50 MB.
TELEGRAM_MAX_ATTACHMENT_BYTES=10485760
TELEGRAM_ATTACHMENT_DOWNLOAD_TIMEOUT_MS=30000
# Test-mode Telegram-to-Webex file relay. Telegram Bot API downloads are capped
# at 20 MB. Render /tmp is ephemeral and intended only for a single instance.
TELEGRAM_INBOUND_ATTACHMENTS_ENABLED=false
TELEGRAM_INBOUND_MAX_ATTACHMENT_BYTES=10485760
TEMP_ATTACHMENT_SIGNING_SECRET=
TEMP_ATTACHMENT_TTL_SECONDS=900
TEMP_ATTACHMENT_DIRECTORY=/tmp/relay-telegram-attachments

# Webex Contact Center Tasks and Subscriptions.
WEBEX_TASKS_URL=https://api.qaus1.ciscoccservice.com/v2/tasks
WEBEX_SUBSCRIPTIONS_URL=https://api.wxcc-us1.cisco.com/v2/subscriptions
WEBEX_ORG_ID=
WEBEX_WEBHOOK_URL=https://your-host.example/api/webhooks/webex
WEBEX_WEBHOOK_SECRET=
WEBEX_DESTINATION_ID=support@telegram.example
WEBEX_CHANNEL_NAME=telegram
# Set true when the WxCC organization encrypts outbound attachments. Encrypted
# files are decrypted with the Webex SDK before Telegram delivery.
WEBEX_OUTBOUND_ATTACHMENTS_ENCRYPTED=false
WEBEX_DECRYPTION_TIMEOUT_MS=60000

# Use either a static Service App token or all three refresh credentials.
# The token needs task scopes and configuration scopes when automatic
# subscription reconciliation is enabled.
WEBEX_ACCESS_TOKEN=
WEBEX_CLIENT_ID=
WEBEX_CLIENT_SECRET=
WEBEX_REFRESH_TOKEN=
WEBEX_OAUTH_URL=https://webexapis.com/v1/access_token

# Sent exactly once when task:connected is received.
AGENT_CONNECTED_MESSAGE=You're now connected to a support agent. They'll be with you shortly.
